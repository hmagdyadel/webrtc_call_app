rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read any user profile (needed for chat lists, search)
      allow read: if request.auth != null;

      // A user can only write to their own document
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Chats ──────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      // Allow read/update/delete only if the authenticated user is in the members array
      allow read, update, delete: if request.auth != null &&
        request.auth.uid in resource.data.members;

      // Allow create if the user is in the new members list
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.members;

      // ── Messages (sub-collection) ─────────────────────────────────────────
      match /messages/{messageId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }

    // ── Stories ────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      // Any authenticated user can read stories
      allow read: if request.auth != null;

      // Only the story owner can create/delete
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
        
      // Owner can update everything. Other users can ONLY append their UID to the 'viewers' array
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers']) &&
          request.auth.uid in request.resource.data.viewers
        )
      );
    }

    // ── WebRTC Calls (Signaling) — Phase 9 ────────────────────────────────
    match /calls/{callId} {
      allow read, update, delete: if request.auth != null &&
        (request.auth.uid == resource.data.callerId ||
         request.auth.uid == resource.data.receiverId);

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.callerId;

      match /candidates/{candidateId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
